---
import Layout from '../layouts/Layout.astro';
---

<Layout title="撒網體驗 | 漁夫視角的海洋保育">
	<section class="relative min-h-screen bg-slate-950 text-slate-100 overflow-hidden">
		<!-- 裝飾背景 -->
		<div class="absolute inset-0 opacity-30">
			<div class="absolute top-20 left-10 w-72 h-72 bg-cyan-400 rounded-full mix-blend-multiply filter blur-3xl"></div>
			<div class="absolute top-40 right-10 w-72 h-72 bg-blue-400 rounded-full mix-blend-multiply filter blur-3xl"></div>
		</div>

		<div class="relative max-w-6xl mx-auto px-6 py-12 md:py-20">
			<!-- 標題區 -->
			<div class="text-center mb-16">
				<h1 class="text-4xl md:text-5xl font-serif font-bold mb-4">撒網體驗</h1>
				<p class="text-lg text-cyan-100/80 max-w-2xl mx-auto">
					踏入漁夫的日常，親身體驗撒網的刺激。但您會發現，現代海洋中充滿了意想不到的挑戰...
				</p>
			</div>

			<!-- 遊戲主要區域 -->
			<div class="grid gap-8 lg:grid-cols-[1fr_320px] mb-12">
				<!-- 遊戲畫布 -->
				<div class="bg-gradient-to-b from-blue-900/40 to-blue-950/60 backdrop-blur-sm rounded-3xl border border-cyan-400/30 p-8 shadow-2xl">
					<div class="relative">
						<!-- 海洋背景 -->
						<div id="oceanBackground" class="relative w-full h-96 md:h-[500px] bg-gradient-to-b from-cyan-500/20 via-blue-600/30 to-blue-900/50 rounded-2xl border border-cyan-300/40 overflow-hidden mb-8">
							<!-- 水波效果 -->
							<div class="absolute inset-0 opacity-20">
								<div class="absolute top-0 w-full h-1 bg-gradient-to-r from-transparent via-cyan-300 to-transparent animate-pulse"></div>
								<div class="absolute top-1/4 w-full h-1 bg-gradient-to-r from-transparent via-cyan-200 to-transparent animate-pulse" style="animation-delay: 0.5s;"></div>
								<div class="absolute top-1/2 w-full h-1 bg-gradient-to-r from-transparent via-cyan-300 to-transparent animate-pulse" style="animation-delay: 1s;"></div>
							</div>

							<!-- 漂浮物質容器 -->
							<div id="itemsContainer" class="absolute inset-0"></div>

							<!-- 撒網圖示 -->
							<div id="networkEffect" class="absolute inset-0 pointer-events-none"></div>

							<!-- 中心提示文字 -->
							<div id="centertext" class="absolute inset-0 flex items-center justify-center">
								<p class="text-xl text-cyan-200/60 font-semibold text-center">點擊準備好撒網！</p>
							</div>
						</div>

						<!-- 控制按鈕 -->
						<div class="flex flex-col sm:flex-row gap-4 justify-center">
							<button id="castNetBtn" class="px-8 py-3 rounded-full border border-white/20 bg-white/5 text-white font-bold hover:bg-white/10 transition-all duration-300">
								撒網
							</button>
							<button id="resetBtn" class="px-8 py-3 rounded-full border border-white/10 bg-transparent text-slate-200 font-bold hover:bg-white/5 transition-all duration-300">
								重新開始
							</button>
						</div>
					</div>
				</div>

				<!-- 統計面板 -->
				<div class="bg-gradient-to-b from-white/10 to-white/5 backdrop-blur-md rounded-2xl border border-white/20 p-6 h-fit sticky top-8">
					<h3 class="text-xl font-bold mb-6 text-cyan-300">統計</h3>
					
					<div class="space-y-4">
						<div class="bg-white/5 rounded-xl p-4 border border-white/10">
							<p class="text-sm text-slate-300 mb-1">撒網次數</p>
							<p id="castCount" class="text-3xl font-bold text-cyan-300">0</p>
						</div>

						<div class="bg-white/5 rounded-xl p-4 border border-white/10">
							<p class="text-sm text-slate-300 mb-1">捕到的魚</p>
							<p id="fishCount" class="text-3xl font-bold text-green-400">0</p>
						</div>

						<div class="bg-white/5 rounded-xl p-4 border border-white/10">
							<p class="text-sm text-slate-300 mb-1">撈到的垃圾</p>
							<p id="trashCount" class="text-3xl font-bold text-orange-400">0</p>
						</div>

						<div class="bg-white/5 rounded-xl p-4 border border-white/10">
							<p class="text-sm text-slate-300 mb-1">成功率</p>
							<p id="successRate" class="text-3xl font-bold text-red-400">0%</p>
						</div>
					</div>

					<div class="mt-6 pt-6 border-t border-white/10">
						<p class="text-xs text-slate-400 text-center">撈到魚的機率：20%<br>撈到垃圾的機率：80%</p>
					</div>
				</div>
			</div>

			<!-- 垃圾分解信息面板 -->
		<div id="trashInfoPanel" class="fixed inset-0 z-50 flex items-center justify-center" style="display: none;">
				<div class="fixed inset-0 bg-black/60 backdrop-blur-sm"></div>
				<div class="relative bg-gradient-to-b from-orange-950 to-orange-900 border-2 border-orange-400 rounded-3xl p-8 max-w-md shadow-2xl mx-4">
					<button id="closeInfoBtn" class="absolute top-4 right-4 text-2xl text-orange-200 hover:text-orange-100 transition">✕</button>
					
					<div class="text-center">
						<h3 id="trashName" class="text-2xl font-bold text-orange-100 mb-2">垃圾類型</h3>
						<div class="bg-orange-950/50 rounded-xl p-4 mb-6 border border-orange-400/30">
							<p class="text-sm text-orange-200/60 mb-2">在海洋中分解所需時間</p>
							<p id="decompositionTime" class="text-3xl font-bold text-orange-300">未知</p>
						</div>
						<p id="trashMessage" class="text-orange-100/80 leading-relaxed mb-6 text-sm"></p>
						<button id="acknowledgeBtn" class="px-6 py-3 rounded-full border border-white/10 bg-orange-500 hover:bg-orange-600 text-white font-bold transition-all duration-300">
							我明白了
						</button>
					</div>
				</div>
			</div>

			<!-- 捕魚成功訊息 -->
		<div id="successPanel" class="fixed inset-0 z-50 flex items-center justify-center" style="display: none;">
				<div class="fixed inset-0 bg-black/60 backdrop-blur-sm"></div>
				<div class="relative bg-gradient-to-b from-green-950 to-emerald-900 border-2 border-green-400 rounded-3xl p-8 max-w-md shadow-2xl mx-4">
						<button id="closeSuccessBtn" class="absolute top-4 right-4 text-sm text-green-200 hover:text-green-100 transition">關閉</button>
					
					<div class="text-center">
						<h3 class="text-2xl font-bold text-green-100 mb-4">太棒了</h3>
						<p class="text-green-100/80 leading-relaxed mb-6">您成功捕到了一條魚，但請記住，適度捕撈才是永續漁業的關鍵。</p>
						<button id="closeSuccessBtnConfirm" class="px-6 py-3 rounded-full border border-white/10 bg-green-500 hover:bg-green-600 text-white font-bold transition-all duration-300">
							繼續
						</button>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 教育資訊區 -->
	<section class="bg-slate-900 text-slate-100 py-16 md:py-20">
		<div class="max-w-6xl mx-auto px-6">
			<h2 class="text-3xl md:text-4xl font-serif font-bold mb-10">為什麼海洋中充滿垃圾？</h2>
			
			<div class="grid gap-8 md:grid-cols-3">
				<article class="rounded-2xl border border-slate-700 bg-slate-800/50 p-6">
					<h3 class="text-xl font-bold mb-3">陸上污染</h3>
					<p class="text-slate-300 leading-relaxed text-sm">城市和工業的廢棄物經由河流流入海洋，成為海洋污染的主要來源，約80%的海洋垃圾來自陸地。</p>
				</article>

				<article class="rounded-2xl border border-slate-700 bg-slate-800/50 p-6">
					<h3 class="text-xl font-bold mb-3">分解時間</h3>
					<p class="text-slate-300 leading-relaxed text-sm">塑膠袋需要500年才能分解，釣魚線需要600年，連最「容易」分解的物品也需要數十年。許多海洋生物因此受傷。</p>
				</article>

				<article class="rounded-2xl border border-slate-700 bg-slate-800/50 p-6">
					<h3 class="text-xl font-bold mb-3">生態威脅</h3>
					<p class="text-slate-300 leading-relaxed text-sm">海洋生物誤食或被纏繞導致傷害或死亡。永續漁業的推動尤為重要，才能保護既有的海洋資源。</p>
				</article>
			</div>

			<div class="mt-12 bg-gradient-to-r from-cyan-900/40 to-blue-900/40 rounded-2xl border border-cyan-400/30 p-8">
				<h3 class="text-2xl font-bold mb-4">我們可以做什麼？</h3>
				<ul class="space-y-3 text-slate-200">
					<li class="flex gap-3"><span>減少一次性塑膠製品的使用，改用可重複使用的購物袋和水瓶</span></li>
					<li class="flex gap-3"><span>支持和購買來自永續漁業認證的海鮮產品</span></li>
					<li class="flex gap-3"><span>參與淨灘活動，直接清潔我們的沿海地區</span></li>
					<li class="flex gap-3"><span>提高環保意識，教育身邊的人關於海洋保育的重要性</span></li>
				</ul>
			</div>
		</div>
	</section>
</Layout>

<script src="../scripts/game.js"></script>
