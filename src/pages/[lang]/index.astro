---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import '../../styles/index.css';
import heroOcean from '../../assets/hero-ocean.jpg';
import { t } from '../../i18n/ui';
import { formatDate } from '../../i18n/utils';
import {t  as tindex } from '../../i18n/index';
export async function getStaticPaths() {
	return [
		{ params: { lang: 'en' } },
		{ params: { lang: 'ja' } },
		{ params: { lang: 'zh-tw' } },
	];
}

const currentLocale = Astro.currentLocale ?? 'zh-tw';
const localeUrl = (path: string) => `/${currentLocale}${path}`;

const latestNews = (await getCollection('news', ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
}))
.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
.slice(0, 3);
---

<Layout title={tindex('home.meta.title', currentLocale)}>
	<section id="hero" class="relative h-screen w-full flex items-center justify-center overflow-hidden">
		<div id="hero-bg" class="absolute inset-0 z-0 will-change-transform">
			<Image 
				src={heroOcean} 
				alt="Ocean Background" 
				class="w-full h-full object-cover scale-110"
			/>
			<div class="absolute inset-0 bg-gradient-to-b from-slate-900/60 via-slate-900/40 to-slate-900 scale-110"></div>
		</div>

		<div id="hero-rain" class="pointer-events-none absolute inset-0 z-[5] overflow-hidden" aria-hidden="true"></div>

		<div id="hero-content" class="relative z-10 text-center px-6 will-change-transform">
			<h1 id="hero-title" class="text-white text-5xl md:text-7xl font-serif mb-6 opacity-0 translate-y-10">
				{tindex('home.hero.title', currentLocale)}

			</h1>
			<p id="hero-desc" class="text-blue-200 text-lg md:text-2xl max-w-2xl mx-auto font-light leading-relaxed opacity-0 translate-y-10" set:html={tindex('home.hero.desc', currentLocale)}>
			    
			</p>
			<div id="hero-cta" class="mt-12 opacity-0 translate-y-10">
				<a href={localeUrl('/story')} class="group inline-flex items-center gap-3 px-10 py-4 rounded-full border border-white/35 bg-white/10 backdrop-blur-xl text-white font-bold tracking-widest transition-all duration-500 hover:-translate-y-1 hover:bg-white/20 hover:border-white/60 hover:shadow-[0_12px_35px_rgba(148,163,184,0.35)]">
					{t('nav.story', currentLocale)}
				</a>
			</div>
		</div>

			<div class="absolute bottom-10 left-1/2 -translate-x-1/2 text-white/30 text-xs tracking-[0.3em] uppercase animate-bounce">
				{t('general.scrollDown', currentLocale)}
			</div>
	</section>

	<section class="relative bg-slate-950 text-slate-100">
		<div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
			<div class="sea-beam sea-beam-one"></div>
			<div class="sea-beam sea-beam-two"></div>
			<div class="sea-beam sea-beam-three"></div>
			<div class="sea-beam sea-beam-four"></div>
			<div class="sea-shimmer"></div>
			<div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(2,6,23,0.08),rgba(2,6,23,0.2))]"></div>
		</div>
		<div class="relative max-w-6xl mx-auto px-6 py-24 md:py-32">
			<div class="max-w-3xl">
				<p class="text-cyan-300/80 tracking-[0.22em] uppercase text-xs md:text-sm">{tindex('home.reality.kicker', currentLocale)}</p>
</p>
				<h2 class="mt-4 text-3xl md:text-5xl font-serif leading-tight">{tindex('home.reality.1.title', currentLocale)}</h2>
				<p class="mt-6 text-slate-300/85 leading-relaxed md:text-lg">
					{tindex('home.reality.1.desc', currentLocale)}
				</p>
			</div>

			<div class="mt-14 grid gap-6 md:grid-cols-3">
				<article class="rounded-2xl border border-cyan-200/15 bg-white/5 backdrop-blur-sm p-6">
					<p class="text-cyan-200 text-sm tracking-wide"># 01</p>
					<h3 class="mt-3 text-xl font-semibold">{tindex('home.reality.1.title', currentLocale)}</h3>
					<p class="mt-3 text-slate-300/90 leading-relaxed">{tindex('home.reality.1.desc', currentLocale)}</p>
				</article>
				<article class="rounded-2xl border border-cyan-200/15 bg-white/5 backdrop-blur-sm p-6">
					<p class="text-cyan-200 text-sm tracking-wide"># 02</p>
					<h3 class="mt-3 text-xl font-semibold">{tindex('home.reality.2.title', currentLocale)}</h3>
					<p class="mt-3 text-slate-300/90 leading-relaxed">{tindex('home.reality.2.desc', currentLocale)}</p>
				</article>
				<article class="rounded-2xl border border-cyan-200/15 bg-white/5 backdrop-blur-sm p-6">
					<p class="text-cyan-200 text-sm tracking-wide"># 03</p>
					<h3 class="mt-3 text-xl font-semibold">{tindex('home.reality.3.title', currentLocale)}</h3>
					<p class="mt-3 text-slate-300/90 leading-relaxed">{tindex('home.reality.3.desc', currentLocale)}</p>
				</article>
			</div>
		</div>
	</section>

	<section class="bg-slate-100 text-slate-900">
		<div class="max-w-6xl mx-auto px-6 py-20 md:py-24 grid gap-10 lg:grid-cols-[1.15fr_1fr] items-start">
			<div>
				<p class="text-sky-700 tracking-[0.2em] uppercase text-xs md:text-sm">{tindex('home.action.kicker', currentLocale)}</p>
				<h2 class="mt-4 text-3xl md:text-5xl font-serif leading-tight" set:html={tindex('home.action.title', currentLocale)}></h2>
				<p class="mt-6 text-slate-700 leading-relaxed md:text-lg">
					{tindex('home.action.desc', currentLocale)}
				</p>
				<div class="mt-9 flex flex-wrap gap-4">
					<a href={localeUrl('/sdg')} class="px-6 py-3 rounded-full bg-sky-700 text-white font-semibold hover:bg-sky-600 transition-colors">{t('nav.sdg', currentLocale)}</a>
					<a href={localeUrl('/news')} class="px-6 py-3 rounded-full border border-slate-300 text-slate-800 font-semibold hover:bg-slate-200 transition-colors">{t('nav.news', currentLocale)}</a>
				</div>
			</div>
			<div class="rounded-3xl border border-slate-200 bg-white p-7 shadow-[0_25px_60px_rgba(15,23,42,0.08)]">
				<h3 class="text-lg font-bold tracking-wide">{tindex('home.action.list.title', currentLocale)}</h3>
				<ul class="mt-5 space-y-4 text-slate-700 leading-relaxed">
					<li>{tindex('home.action.list.1', currentLocale)}</li>
					<li>{tindex('home.action.list.2', currentLocale)}</li>
					<li>{tindex('home.action.list.3', currentLocale)}</li>
				</ul>
			</div>
		</div>
	</section>

	<section class="bg-slate-950 text-slate-100">
		<div class="max-w-6xl mx-auto px-6 py-20 md:py-24">
			<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
				<div class="max-w-2xl">
					<p class="text-cyan-300/80 tracking-[0.22em] uppercase text-xs md:text-sm">{tindex('home.news.kicker', currentLocale)}</p>
					<h2 class="mt-4 text-3xl md:text-5xl font-serif leading-tight">{tindex('home.news.title', currentLocale)}</h2>
					<p class="mt-5 text-slate-300/85 leading-relaxed md:text-lg">
						{tindex('home.news.desc', currentLocale)}
					</p>
				</div>
				<a href={localeUrl('/news')} class="inline-flex w-fit items-center justify-center rounded-full border border-cyan-200/25 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10">
					{t('news.latest', currentLocale)}
				</a>
			</div>

			<div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
				{latestNews.map((item: CollectionEntry<'news'>) => (
					<article class="group overflow-hidden rounded-3xl border border-white/10 bg-white/5 backdrop-blur-sm shadow-[0_18px_60px_rgba(2,6,23,0.35)] transition-transform duration-300 hover:-translate-y-1">
						<div class="relative aspect-[16/10] overflow-hidden bg-slate-800">
							<img src={item.data.cover.src} alt={item.data.title} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
							<div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/15 to-transparent"></div>
						</div>
						<div class="p-6">
							<p class="text-xs tracking-[0.22em] uppercase text-cyan-300/80">News</p>
							<h3 class="mt-3 text-xl font-semibold leading-snug text-white">{item.data.title}</h3>
							<p class="mt-3 text-sm text-slate-300/80">{formatDate(item.data.date, currentLocale)}</p>
							<p class="mt-4 line-clamp-4 text-slate-300/90 leading-relaxed">{item.data.summary}</p>
							<a href={localeUrl(`/news/${item.id}`)} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-cyan-300 transition-colors hover:text-cyan-200">
								{t('news.readMore', currentLocale)}
								<span aria-hidden="true">→</span>
							</a>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>
</Layout>

    <section class="bg-slate-950 text-slate-100">
        <div class="max-w-6xl mx-auto px-6 py-20 md:py-24">
            <div class="mt-10 grid gap-6 md:grid-cols-3">

<script>
	import '../../scripts/index-hero.js';
</script>