---
import Layout from '../../layouts/Layout.astro';
import SakanaWidget from '../../components/SakanaWidget.astro';
import { t as tgame, ui as gameUi, getTrashItems } from '../../i18n/game';


export async function getStaticPaths() {
	return [
		{ params: { lang: 'en' } },
		{ params: { lang: 'ja' } },
		{ params: { lang: 'zh-tw' } },
	];
}
const currentLocale = Astro.currentLocale ?? 'zh-tw'; 
const localeUrl = (path: string) => `/${currentLocale}${path}`;
const pageLocale = (currentLocale === 'en' || currentLocale === 'ja' ? currentLocale : 'zh-tw') as 'zh-tw' | 'en' | 'ja';
const localeKey = currentLocale as keyof typeof gameUi;
// 在伺服器端抓好對應語言的陣列
const currentTrashData = getTrashItems(currentLocale);
const i18nData = gameUi[localeKey] ?? gameUi['zh-tw'];
const bootstrapScript = `window.GAME_TRASH_ITEMS = ${JSON.stringify(currentTrashData)}; window.GAME_I18N = ${JSON.stringify(i18nData)};`;
---

<Layout title={tgame('game.meta.title', currentLocale)}>
	<section class="relative min-h-screen bg-slate-950 text-slate-100 overflow-hidden">
		<!-- 裝飾背景 -->
		<div class="absolute inset-0 opacity-20">
			<div class="absolute top-20 left-10 w-72 h-72 bg-slate-700/40 rounded-full mix-blend-multiply filter blur-3xl"></div>
			<div class="absolute top-40 right-10 w-72 h-72 bg-slate-600/30 rounded-full mix-blend-multiply filter blur-3xl"></div>
		</div>

		<div class="relative max-w-6xl mx-auto px-6 py-12 md:py-20">
			<!-- 標題區 -->
			<div class="text-center mb-16">
				<h1 class="text-4xl md:text-5xl font-serif font-bold mb-4">{tgame('game.hero.title', currentLocale)}</h1>
				<p class="text-lg text-cyan-100/80 max-w-2xl mx-auto">
					{tgame('game.hero.desc', currentLocale)}
				</p>
			</div>

			<!-- 遊戲主要區域 -->
			<div class="grid gap-8 lg:grid-cols-[1fr_320px] mb-12">
				<!-- 遊戲畫布 -->
				<div class="bg-gradient-to-b from-slate-800/20 to-slate-900/40 backdrop-blur-sm rounded-3xl border border-slate-700/20 p-8 shadow-2xl">
					<div class="relative">
						<!-- 海洋背景 -->
						<div id="oceanBackground" class="relative w-full h-96 md:h-[500px] bg-gradient-to-b from-slate-700/10 via-slate-700/20 to-slate-900/40 rounded-2xl border border-slate-700/30 overflow-hidden mb-8">
							<!-- 水波效果 -->
							<div class="absolute inset-0 opacity-20">
								<div class="absolute top-0 w-full h-1 bg-gradient-to-r from-transparent via-slate-400 to-transparent animate-pulse"></div>
								<div class="absolute top-1/4 w-full h-1 bg-gradient-to-r from-transparent via-slate-400 to-transparent animate-pulse" style="animation-delay: 0.5s;"></div>
								<div class="absolute top-1/2 w-full h-1 bg-gradient-to-r from-transparent via-slate-400 to-transparent animate-pulse" style="animation-delay: 1s;"></div>
							</div>

							<!-- 漂浮物質容器 -->
							<div id="itemsContainer" class="absolute inset-0"></div>

							<!-- 撒網圖示 -->
							<div id="networkEffect" class="absolute inset-0 pointer-events-none"></div>

							<!-- 中心提示文字 -->
								<div id="centertext" class="absolute inset-0 flex items-center justify-center">
								<p class="text-xl text-slate-300/60 font-semibold text-center">{tgame('game.canvas.prompt', currentLocale)}</p>
							</div>
						</div>

						<!-- 控制按鈕 -->
						<div class="flex flex-col sm:flex-row gap-4 justify-center">
							<button id="castNetBtn" class="px-8 py-3 rounded-full border border-white/20 bg-white/5 text-white font-bold hover:bg-white/10 transition-all duration-300">
								{tgame('game.btn.cast', currentLocale)}
							</button>
							<button id="tenDrawBtn" class="px-8 py-3 rounded-full border border-white/20 bg-white/5 text-white font-bold hover:bg-white/10 transition-all duration-300">
								{tgame('game.btn.tenDraw', currentLocale)}
							</button>
							<button id="resetBtn" class="px-8 py-3 rounded-full border border-white/10 bg-transparent text-slate-200 font-bold hover:bg-white/5 transition-all duration-300">
								{tgame('game.btn.reset', currentLocale)}
							</button>
						</div>
					</div>
				</div>

				<!-- 統計面板 -->
				<div class="bg-gradient-to-b from-white/10 to-white/5 backdrop-blur-md rounded-2xl border border-white/20 p-6 h-fit sticky top-8">
					<h3 class="text-xl font-bold mb-6 text-cyan-300">{tgame('game.stats.title', currentLocale)}</h3>
					
					<div class="space-y-4">
						<div class="bg-white/5 rounded-xl p-4 border border-white/10">
							<p class="text-sm text-slate-300 mb-1">{tgame('game.stats.castCount', currentLocale)}</p>
							<p id="castCount" class="text-3xl font-bold text-cyan-300">0</p>
						</div>

						<div class="bg-white/5 rounded-xl p-4 border border-white/10">
							<p class="text-sm text-slate-300 mb-1">{tgame('game.stats.fishCount', currentLocale)}</p>
							<p id="fishCount" class="text-3xl font-bold text-green-400">0</p>
						</div>

						<div class="bg-white/5 rounded-xl p-4 border border-white/10">
							<p class="text-sm text-slate-300 mb-1">{tgame('game.stats.trashCount', currentLocale)}</p>
							<p id="trashCount" class="text-3xl font-bold text-orange-400">0</p>
						</div>

						<div class="bg-white/5 rounded-xl p-4 border border-white/10">
							<p class="text-sm text-slate-300 mb-1">{tgame('game.stats.successRate', currentLocale)}</p>
							<p id="successRate" class="text-3xl font-bold text-red-400">0%</p>
						</div>
					</div>

					<div class="mt-6 pt-6 border-t border-white/10">
						<p class="text-xs text-slate-400 text-center">{tgame('game.stats.probability', currentLocale)}</p>
					</div>
				</div>
			</div>

			<!-- 垃圾分解信息面板 -->
			<div id="trashInfoPanel" class="fixed inset-0 z-60 flex items-center justify-center" style="display: none;">
				<div class="fixed inset-0 bg-black/60 backdrop-blur-sm"></div>
				<div class="relative bg-gradient-to-b from-slate-900 to-slate-800 border border-white/10 rounded-3xl p-8 max-w-md shadow-2xl mx-4">
					<button id="closeInfoBtn" class="absolute top-4 right-4 text-sm text-slate-300 hover:text-white transition">{tgame('game.panel.close', currentLocale)}</button>
					
					<div class="text-center">
						<div id="trashIcon" class="mb-4 flex justify-center items-center"></div>
						<h3 id="trashName" class="text-2xl font-bold text-slate-100 mb-2">{tgame('game.panel.trash.type', currentLocale)}</h3>
						<div class="bg-white/5 rounded-xl p-4 mb-6 border border-white/10">
							<p class="text-sm text-slate-400 mb-2">{tgame('game.panel.trash.timeLabel', currentLocale)}</p>
							<p id="decompositionTime" class="text-3xl font-bold text-slate-200">{tgame('game.panel.trash.unknown', currentLocale)}</p>
						</div>
						<p id="trashMessage" class="text-slate-300 leading-relaxed mb-6 text-sm"></p>
						<button id="acknowledgeBtn" class="px-6 py-3 rounded-full border border-white/10 bg-white/10 hover:bg-white/15 text-white font-bold transition-all duration-300">
							{tgame('game.panel.trash.acknowledge', currentLocale)}
						</button>
					</div>
				</div>
			</div>

			<!-- 捕魚成功訊息 -->
			<div id="successPanel" class="fixed inset-0 z-60 flex items-center justify-center" style="display: none;">
				<div class="fixed inset-0 bg-black/60 backdrop-blur-sm"></div>
				<div class="relative bg-gradient-to-b from-slate-900 to-slate-800 border border-white/10 rounded-3xl p-8 max-w-md shadow-2xl mx-4">
						<button id="closeSuccessBtn" class="absolute top-4 right-4 text-sm text-slate-300 hover:text-white transition">{tgame('game.panel.close', currentLocale)}</button>
					
					<div class="text-center">
						<div id="successIcon" class="mb-4 flex justify-center items-center"></div>
						<h3 class="text-2xl font-bold text-slate-100 mb-4">{tgame('game.panel.success.title', currentLocale)}</h3>
						<p class="text-slate-300 leading-relaxed mb-6">{tgame('game.panel.success.desc', currentLocale)}</p>
						<button id="closeSuccessBtnConfirm" class="px-6 py-3 rounded-full border border-white/10 bg-white/10 hover:bg-white/15 text-white font-bold transition-all duration-300">
							{tgame('game.panel.success.continue', currentLocale)}
						</button>
					</div>
				</div>
			</div>

			<!-- 十連抽結果面板 -->
			<div id="tenDrawPanel" class="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto px-3 py-3 sm:items-center sm:px-6 sm:py-8" style="display: none;">
				<div class="fixed inset-0 bg-black/60 backdrop-blur-sm"></div>
				<div class="relative flex w-full max-w-3xl max-h-[calc(100svh-1.5rem)] min-h-0 flex-col overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-b from-slate-900 to-slate-800 p-4 shadow-2xl sm:p-8">
					<button id="closeTenDrawBtn" class="absolute top-4 right-4 text-sm text-slate-300 hover:text-white transition">{tgame('game.panel.close', currentLocale)}</button>
					<div class="shrink-0 text-center mb-4 sm:mb-6">
						<p class="text-cyan-200 text-xs sm:text-xs tracking-[0.22em] uppercase">Ten Draw</p>
						<h3 class="text-xl sm:text-2xl md:text-3xl font-bold text-slate-100 mt-2 sm:mt-3">{tgame('game.panel.tenDraw.title', currentLocale)}</h3>
						<p class="text-slate-400 text-xs sm:text-sm mt-2">{tgame('game.panel.tenDraw.desc', currentLocale)}</p>
					</div>
					<div id="tenDrawResults" class="grid min-h-0 flex-1 grid-cols-2 content-start gap-2 overflow-y-auto overscroll-contain pb-2 pr-1 touch-pan-y sm:gap-4 sm:grid-cols-2 lg:grid-cols-5"></div>
				</div>
			</div>
		</div>
	</section>

	<!-- 教育資訊區 -->
	<section class="bg-slate-900 text-slate-100 py-16 md:py-20">
		<div class="max-w-6xl mx-auto px-6">
			<h2 class="text-3xl md:text-4xl font-serif font-bold mb-10">{tgame('game.edu.title', currentLocale)}</h2>
			
			<div class="grid gap-8 md:grid-cols-3">
				<article class="rounded-2xl border border-slate-700 bg-slate-800/50 p-6">
					<h3 class="text-xl font-bold mb-3">{tgame('game.edu.1.title', currentLocale)}</h3>
					<p class="text-slate-300 leading-relaxed text-sm">{tgame('game.edu.1.desc', currentLocale)}</p>
				</article>

				<article class="rounded-2xl border border-slate-700 bg-slate-800/50 p-6">
					<h3 class="text-xl font-bold mb-3">{tgame('game.edu.2.title', currentLocale)}</h3>
					<p class="text-slate-300 leading-relaxed text-sm">{tgame('game.edu.2.desc', currentLocale)}</p>
				</article>

				<article class="rounded-2xl border border-slate-700 bg-slate-800/50 p-6">
					<h3 class="text-xl font-bold mb-3">{tgame('game.edu.3.title', currentLocale)}</h3>
					<p class="text-slate-300 leading-relaxed text-sm">{tgame('game.edu.3.desc', currentLocale)}</p>
				</article>
			</div>

			<div class="mt-12 bg-gradient-to-r from-cyan-900/40 to-blue-900/40 rounded-2xl border border-cyan-400/30 p-8 md:p-10" id="action-external">
				<h3 class="text-2xl font-bold mb-6">{tgame('game.action.title', currentLocale)}</h3>
				
				<ul class="space-y-3 text-slate-200 mb-8">
					<li class="flex gap-3"><span>{tgame('game.action.1', currentLocale)}</span></li>
					<li class="flex gap-3"><span>{tgame('game.action.2', currentLocale)}</span></li>
					<li class="flex gap-3"><span>{tgame('game.action.3', currentLocale)}</span></li>
					<li class="flex gap-3"><span>{tgame('game.action.4', currentLocale)}</span></li>
				</ul>

				<div class="h-px w-full bg-gradient-to-r from-transparent via-cyan-400/30 to-transparent mb-8"></div>

				
				<div class="mb-4">
					<h4 class="text-lg font-semibold text-cyan-200">{tgame('game.action.external.title', currentLocale)}</h4>
					<p class="text-sm text-slate-200 mt-1">{tgame('game.action.external.note', currentLocale)}</p>
				</div>
				
				<div class="grid md:grid-cols-2 gap-4 md:gap-6">
					<a href="https://iocean.oca.gov.tw/" target="_blank" rel="noopener noreferrer" class="group p-5 rounded-xl border border-cyan-400/20 bg-slate-900/40 hover:bg-cyan-900/50 hover:border-cyan-400/50 transition-all duration-300 h-full flex flex-col cursor-pointer">
						<h5 class="text-lg font-bold text-cyan-300 mb-2 group-hover:text-cyan-100">{tgame('game.action.iocean.title', currentLocale)}</h5>
						<p class="text-sm text-slate-300 leading-relaxed flex-grow">{tgame('game.action.iocean.desc', currentLocale)}</p>
						<div class="mt-4 text-xs font-semibold tracking-wider text-cyan-400 group-hover:text-cyan-200 flex items-center gap-1 uppercase">
							{tgame('game.action.iocean.cta', currentLocale)} <span class="group-hover:translate-x-1 transition-transform">→</span>
						</div>
					</a>

					<a href="https://bbrally.org/" target="_blank" rel="noopener noreferrer" class="group p-5 rounded-xl border border-emerald-400/20 bg-slate-900/40 hover:bg-emerald-900/50 hover:border-emerald-400/50 transition-all duration-300 h-full flex flex-col cursor-pointer">
						<h5 class="text-lg font-bold text-emerald-400 mb-2 group-hover:text-emerald-200">{tgame('game.action.bbrally.title', currentLocale)}</h5>
						<p class="text-sm text-slate-300 leading-relaxed flex-grow">{tgame('game.action.bbrally.desc', currentLocale)}</p>
						<div class="mt-4 text-xs font-semibold tracking-wider text-emerald-400 group-hover:text-emerald-200 flex items-center gap-1 uppercase">
							{tgame('game.action.bbrally.cta', currentLocale)} <span class="group-hover:translate-x-1 transition-transform">→</span>
						</div>
					</a>
				</div>
			</div>
			</div>
		</section>

		<SakanaWidget />
		
	</section>
</Layout>

<script set:html={bootstrapScript}></script>
<script src="../../scripts/game.js"></script>
