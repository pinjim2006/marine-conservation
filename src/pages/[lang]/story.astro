---
// ===== 導入模組 =====
import Layout from "../../layouts/Layout.astro";
import "../../styles/story.css";
import { t as tui } from "../../i18n/ui";
import { t as tstory } from "../../i18n/story";

// ===== 靜態路徑生成 =====
export async function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "ja" } },
    { params: { lang: "zh-tw" } },
  ];
}

// ===== 語言配置 =====
const currentLocale = Astro.currentLocale ?? "zh-tw";
const localeUrl = (path: string) => `/${currentLocale}${path}`;
---

<Layout title={tstory("story.meta.title", currentLocale)}>
  {/* ===== 故事頁面主容器 ===== */}
  <div class="story-page" data-story-root>
    {/* 動態背景色彩層 — GSAP scrub 驅動洗色 */}
    <div class="story-scene" data-scene-backdrop></div>

    {/* 噪點紋理效果 */}
    <div class="story-noise" aria-hidden="true"></div>

    {/* 進度條 */}
    <div class="story-progress" data-progress-bar></div>

    {/* ===== 側邊進度指示器 ===== */}
    <aside class="story-rail" aria-hidden="true">
      <span data-progress-dot></span>
      <span data-progress-dot></span>
      <span data-progress-dot></span>
      <span data-progress-dot></span>
      <span data-progress-dot></span>
    </aside>

    {/* ===== 英雄區段 ===== */}
    <section class="story-hero" data-story-hero>
      <div class="story-hero__layers" aria-hidden="true">
        <span
          class="story-orb story-orb--a"
          data-parallax="120"
          data-mouse-layer="0.6"></span>
        <span
          class="story-orb story-orb--b"
          data-parallax="90"
          data-mouse-layer="0.4"></span>
        <span
          class="story-orb story-orb--c"
          data-parallax="60"
          data-mouse-layer="0.2"></span>
        <span
          class="story-wave story-wave--a"
          data-parallax="-80"
          data-mouse-layer="0.3"></span>
        <span
          class="story-wave story-wave--b"
          data-parallax="-140"
          data-mouse-layer="0.4"></span>
      </div>

      <div class="story-hero__content" data-mouse-layer="0.12">
        <p class="story-kicker">{tstory("story.hero.kicker", currentLocale)}</p>
        <h1 data-split>{tstory("story.hero.title", currentLocale)}</h1>
        <p class="story-lead" data-split>
          {tstory("story.hero.lead", currentLocale)}
        </p>
        <div class="story-hero__meta">
          <span>{tstory("story.hero.meta", currentLocale)}</span>
        </div>
        <div class="story-scroll-hint">
          {tui("general.scrollDown", currentLocale)}
        </div>
      </div>
    </section>

    {/* ===== 主要故事內容區 ===== */}
    <main data-story-content>
      {/* ============================================= */}
      {/* ===== Scene 1：養大我們的那片海 ===== */}
      {/* 通透的琉璃海 — 湖水綠/淺青漸變 */}
      {/* ============================================= */}
      <section
        class="story-section"
        data-story-section
        data-scene-id="scene-1"
        data-scene-color="#0d4f4f"
        data-scene-end="#0a3d5c"
        data-scene-accent="#5eead4"
      >
        {/* 背景層: 垂直光幕 (Volumetric Light) */}
        <div
          class="parallax-layer--bg"
          data-parallax-layer="bg"
          aria-hidden="true"
        >
          <div class="scene-assets" data-scene-assets="lightshafts"></div>
        </div>

        {/* 前景層: 極細小氣泡 — 極快速上升 */}
        <div
          class="parallax-layer--fg"
          data-parallax-layer="fg"
          aria-hidden="true"
        >
          <div class="scene-assets" data-scene-assets="bubbles"></div>
        </div>

        {/* 中景層: 文字內容 */}
        <div class="story-section__inner" data-parallax-layer="mid">
          <div class="story-section__header">
            <p class="story-section__label">
              {tstory("story.scene1.label", currentLocale)}
            </p>
            <h2 data-split>{tstory("story.scene1.title", currentLocale)}</h2>
          </div>
          <div class="story-body">
            <p data-reveal>{tstory("story.scene1.p1", currentLocale)}</p>
            <p data-reveal>
              {tstory("story.scene1.p2", currentLocale)}
            </p>
            <p data-reveal>
              {tstory("story.scene1.p3", currentLocale)}
            </p>
          </div>
          <div class="story-divider" aria-hidden="true"></div>
        </div>
      </section>

      {/* ============================================= */}
      {/* ===== Scene 2：那時候，魚多到抓不完 ===== */}
      {/* 深邃靛藍 — 銀色魚群光暈 */}
      {/* ============================================= */}
      <section
        class="story-section"
        data-story-section
        data-scene-id="scene-2"
        data-scene-color="#0f3460"
        data-scene-end="#0a192f"
        data-scene-accent="#38bdf8"
      >
        {/* 背景層: 深層銀色光暈 */}
        <div
          class="parallax-layer--bg"
          data-parallax-layer="bg"
          aria-hidden="true"
        >
          <div class="scene-assets" data-scene-assets="streaks-bg"></div>
        </div>

        {/* 中景層: 中速銀色光暈 — 魚球核心 */}
        <div
          class="parallax-layer--mid"
          data-parallax-layer="mid-deco"
          aria-hidden="true"
        >
          <div class="scene-assets" data-scene-assets="streaks-mid"></div>
        </div>

        {/* 前景層: 快速銀色光暈 */}
        <div
          class="parallax-layer--fg"
          data-parallax-layer="fg"
          aria-hidden="true"
        >
          <div class="scene-assets" data-scene-assets="streaks-fg"></div>
        </div>

        {/* 文字層 */}
        <div class="story-section__inner" data-parallax-layer="mid">
          <div class="story-section__header">
            <p class="story-section__label">
              {tstory("story.scene2.label", currentLocale)}
            </p>
            <h2 data-split>{tstory("story.scene2.title", currentLocale)}</h2>
          </div>
          <div class="story-body">
            <p data-reveal>{tstory("story.scene2.p1", currentLocale)}</p>
            <p data-reveal>
              {tstory("story.scene2.p2.before", currentLocale)}<span
                class="story-emphasis"
                data-emphasis
                >{tstory("story.scene2.p2.emphasis", currentLocale)}</span
              >{tstory("story.scene2.p2.after", currentLocale)}
            </p>
            <p data-reveal>
              {tstory("story.scene2.p3.before", currentLocale)}<span
                class="story-emphasis"
                data-emphasis
                >{tstory("story.scene2.p3.emphasis", currentLocale)}</span
              >{tstory("story.scene2.p3.after", currentLocale)}
            </p>
          </div>
          <div class="story-divider" aria-hidden="true"></div>
        </div>
      </section>

      {/* ============================================= */}
      {/* ===== Scene 3：網是沉的，魚卻沒了 ===== */}
      {/* 混濁灰褐泥淖 — 塑膠薄膜覆蓋 */}
      {/* ============================================= */}
      <section
        class="story-section"
        data-story-section
        data-scene-id="scene-3"
        data-scene-color="#3d2b1f"
        data-scene-end="#1c1917"
        data-scene-accent="#a8a29e"
      >
        {/* 背景層: 垃圾碎片緩慢沉降 */}
        <div
          class="parallax-layer--bg"
          data-parallax-layer="bg"
          aria-hidden="true"
        >
          <div class="scene-assets" data-scene-assets="debris"></div>
        </div>

        {/* 極度前景覆蓋層: 巨大半透明塑膠薄膜 */}
        <div
          class="parallax-layer--overlay"
          data-parallax-layer="overlay"
          aria-hidden="true"
        >
          <div class="scene-plastic-film" data-plastic-film></div>
        </div>

        {/* 文字層 */}
        <div class="story-section__inner" data-parallax-layer="mid">
          <div class="story-section__header">
            <p class="story-section__label">
              {tstory("story.scene3.label", currentLocale)}
            </p>
            <h2 data-split>{tstory("story.scene3.title", currentLocale)}</h2>
          </div>
          <div class="story-body">
            <p class="story-break" data-reveal>
              {tstory("story.scene3.p1", currentLocale)}
            </p>
            <p data-reveal>
              {tstory("story.scene3.p2", currentLocale)}
            </p>
            <p data-reveal>
              {tstory("story.scene3.p3", currentLocale)}
            </p>
            <p data-reveal>
              <span class="story-emphasis story-emphasis--strong" data-emphasis
                >{tstory("story.scene3.p4", currentLocale)}</span
              >
            </p>
          </div>
          <div class="story-divider" aria-hidden="true"></div>
        </div>
      </section>

      {/* ============================================= */}
      {/* ===== Scene 4：海撐不住，我們也快撐不住了 ===== */}
      {/* 原油外洩的深淵 — 純黑 + 毒性光斑 */}
      {/* ============================================= */}
      <section
        class="story-section"
        data-story-section
        data-scene-id="scene-4"
        data-scene-color="#080808"
        data-scene-end="#000000"
        data-scene-accent="#fb7185"
      >
        {/* 背景層: 毒性徑向漸層光斑 */}
        <div
          class="parallax-layer--bg"
          data-parallax-layer="bg"
          aria-hidden="true"
        >
          <div class="scene-assets" data-scene-assets="toxic-glow"></div>
        </div>

        {/* 全視角層: 混亂微塑膠碎片 */}
        <div
          class="parallax-layer--fg"
          data-parallax-layer="fg"
          aria-hidden="true"
        >
          <div class="scene-assets" data-scene-assets="microplastic">
            <div class="scene-noise-overlay"></div>
          </div>
        </div>

        {/* 文字層 */}
        <div class="story-section__inner" data-parallax-layer="mid">
          <div class="story-section__header">
            <p class="story-section__label">
              {tstory("story.scene4.label", currentLocale)}
            </p>
            <h2 data-split>{tstory("story.scene4.title", currentLocale)}</h2>
          </div>
          <div class="story-body">
            <p data-reveal>{tstory("story.scene4.p1", currentLocale)}</p>
            <p data-reveal>
              {tstory("story.scene4.p2", currentLocale)}
            </p>
            <p data-reveal>
              {tstory("story.scene4.p3", currentLocale)}
            </p>
            <p data-reveal>
              {tstory("story.scene4.p4.before", currentLocale)}<span
                class="story-emphasis"
                data-emphasis
                >{tstory("story.scene4.p4.emphasis", currentLocale)}</span
              >{tstory("story.scene4.p4.after", currentLocale)}
            </p>
            <p data-reveal>
              <span class="story-emphasis story-emphasis--strong" data-emphasis
                >{tstory("story.scene4.p5", currentLocale)}</span
              >
            </p>
          </div>
          <div class="story-divider" aria-hidden="true"></div>
        </div>
      </section>

      {/* ============================================= */}
      {/* ===== Scene 5：海要是壞了，誰來修？ ===== */}
      {/* 徹底的漆黑 — 孤獨的魚鉤 */}
      {/* ============================================= */}
      <section
        class="story-section"
        data-story-section
        data-scene-id="scene-5"
        data-scene-color="#020202"
        data-scene-end="#000000"
        data-scene-accent="#5eead4"
      >
        {/* 前景層: 魚鉤懸掛 */}
        <div
          class="parallax-layer--fg"
          data-parallax-layer="fg"
          aria-hidden="true"
        >
          <div class="scene-fishhook-container" data-fishhook>
            <div class="scene-fishing-line"></div>
            <div class="scene-fishhook">
              <svg
                viewBox="0 0 28 42"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                {/* 魚鉤 SVG — 生鏽的金屬質感 */}
                <path
                  d="M14 0 L14 22 Q14 34 8 38 Q2 42 2 36 Q2 30 8 28"
                  stroke="currentColor"
                  stroke-width="1.5"
                  fill="none"
                  stroke-linecap="round"></path>
                {/* 倒鉤 */}
                <path
                  d="M8 28 L5 24"
                  stroke="currentColor"
                  stroke-width="1.2"
                  stroke-linecap="round"></path>
              </svg>
            </div>
            {/* 微弱發光點 */}
            <div class="scene-float-light" data-float-light></div>
          </div>
        </div>

        {/* 文字層 */}
        <div class="story-section__inner" data-parallax-layer="mid">
          <div class="story-section__header">
            <p class="story-section__label">
              {tstory("story.scene5.label", currentLocale)}
            </p>
            <h2 data-split>{tstory("story.scene5.title", currentLocale)}</h2>
          </div>
          <div class="story-body">
            <blockquote class="story-quote" data-reveal>
              <p>
                <span class="story-emphasis" data-emphasis
                  >{tstory("story.scene5.quote.1", currentLocale)}</span
                >
              </p>
              <p>
                <span class="story-emphasis" data-emphasis
                  >{tstory("story.scene5.quote.2", currentLocale)}</span
                >
              </p>
            </blockquote>
            <p data-reveal>{tstory("story.scene5.p1", currentLocale)}</p>
            <p data-reveal>
              {tstory("story.scene5.p2", currentLocale)}
            </p>
          </div>
        </div>
      </section>

      {/* ===== 行動呼籲區段 ===== */}
      <section class="story-cta" data-cta>
        <div class="story-cta__card">
          <h3 data-split>{tstory("story.cta.title", currentLocale)}</h3>
          <p data-reveal>
            {tstory("story.cta.desc", currentLocale)}
          </p>
          <a
            class="story-cta__button"
            data-cta-button
            href={`${localeUrl("/game")}#action-external`}
            >{tui("cta.join", currentLocale)}</a
          >
        </div>
      </section>
    </main>

    <script>
      {
        /* ===== 動畫初始化腳本 ===== */
      }
      import {
        initStoryAnimations,
        cleanupStoryAnimations,
      } from "../../scripts/story-animations.js";

      document.addEventListener("DOMContentLoaded", initStoryAnimations);
      document.addEventListener("astro:before-swap", cleanupStoryAnimations);
    </script>
  </div>
</Layout>
