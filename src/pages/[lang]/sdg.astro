---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { t } from '../../i18n/ui';
import { type SDGKey, t as tsdg } from '../../i18n/sdg';
import img141 from '../../assets/sdg/GOAL_14_TARGET_14.1.png';
import img142 from '../../assets/sdg/GOAL_14_TARGET_14.2.png';
import img143 from '../../assets/sdg/GOAL_14_TARGET_14.3.png';
import img144 from '../../assets/sdg/GOAL_14_TARGET_14.4.png';
import img145 from '../../assets/sdg/GOAL_14_TARGET_14.5.png';
import img146 from '../../assets/sdg/GOAL_14_TARGET_14.6.png';
import img147 from '../../assets/sdg/GOAL_14_TARGET_14.7.png';
import img14A from '../../assets/sdg/GOAL_14_TARGET_14.A.png';
import img14B from '../../assets/sdg/GOAL_14_TARGET_14.B.png';
import img14C from '../../assets/sdg/GOAL_14_TARGET_14.C.png';
import imgSdg14 from '../../assets/sdg/TheGlobalGoals_Icons_Color_Goal_14.png';

export async function getStaticPaths() {
	return [
		{ params: { lang: 'en' } },
		{ params: { lang: 'zh-tw' } },
	];
}

const currentLocale = Astro.currentLocale ?? 'zh-tw';
const localeUrl = (path: string) => `/${currentLocale}${path}`;

type SdgTarget = {
	id: string;
	title: SDGKey;
	src: typeof img141;
	desc: SDGKey;
};

const detailedTargets: SdgTarget[] = [
	{
		id: '14.1',
		title: 'sdg.target.14.1.title',
		src: img141,
		desc: 'sdg.target.14.1.desc',
	},
	{
		id: '14.2',
		title: 'sdg.target.14.2.title',
		src: img142,
		desc: 'sdg.target.14.2.desc',
	},
	{
		id: '14.3',
		title: 'sdg.target.14.3.title',
		src: img143,
		desc: 'sdg.target.14.3.desc',
	},
	{
		id: '14.4',
		title: 'sdg.target.14.4.title',
		src: img144,
		desc: 'sdg.target.14.4.desc',
	},
	{
		id: '14.5',
		title: 'sdg.target.14.5.title',
		src: img145,
		desc: 'sdg.target.14.5.desc',
	},
	{
		id: '14.6',
		title: 'sdg.target.14.6.title',
		src: img146,
		desc: 'sdg.target.14.6.desc',
	},
	{
		id: '14.7',
		title: 'sdg.target.14.7.title',
		src: img147,
		desc: 'sdg.target.14.7.desc',
	},
	{
		id: '14.A',
		title: 'sdg.target.14.a.title',
		src: img14A,
		desc: 'sdg.target.14.a.desc',
	},
	{
		id: '14.B',
		title: 'sdg.target.14.b.title',
		src: img14B,
		desc: 'sdg.target.14.b.desc',
	},
	{
		id: '14.C',
		title: 'sdg.target.14.c.title',
		src: img14C,
		desc: 'sdg.target.14.c.desc',
	},
];
---

<Layout title="SDG 14：保育海洋生態 | 漁夫視角的海洋保育">
	<section id="sdgHero" class="relative overflow-hidden bg-sky-950 text-white flex items-center">
		<canvas id="sdgHeroCanvas" class="sdg-hero-canvas" aria-hidden="true"></canvas>
		<div class="absolute inset-0 sdg-hero-vignette" aria-hidden="true"></div>
		<div class="relative z-10 max-w-6xl mx-auto px-6 py-0 grid gap-10 md:grid-cols-[260px_1fr] items-center">
			<Image
				src={imgSdg14}
				alt="聯合國永續發展目標 SDG14 圖示"
				class="w-44 md:w-60 rounded-2xl shadow-2xl shadow-cyan-900/40"
			/>
			<div>
				<p class="text-cyan-200/90 uppercase tracking-[0.24em] text-xs md:text-sm">{tsdg('sdg.hero.kicker', currentLocale)}</p>
				<h1 class="mt-4 text-3xl md:text-5xl font-serif leading-tight">{tsdg('sdg.target.14.title', currentLocale)}</h1>
				<p class="mt-6 text-slate-200/90 leading-relaxed md:text-lg">
					{tsdg('sdg.target.14.desc', currentLocale)}
				</p>
			</div>
		</div>
		<div class="absolute bottom-10 left-1/2 -translate-x-1/2 text-white/30 text-xs tracking-[0.3em] uppercase animate-bounce">
			{t('general.scrollDown', currentLocale)}
		</div>
	</section>

	<section class="bg-slate-100 text-slate-900">
		<div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
			<h2 class="text-2xl md:text-4xl font-serif">{tsdg('sdg.why.title', currentLocale)}</h2>
			<div class="mt-8 grid gap-6 md:grid-cols-3">
				<article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
					<h3 class="text-lg font-semibold">{tsdg('sdg.why.1.title', currentLocale)}</h3>
					<p class="mt-3 text-slate-700 leading-relaxed">{tsdg('sdg.why.1.desc', currentLocale)}</p>
				</article>
				<article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
					<h3 class="text-lg font-semibold">{tsdg('sdg.why.2.title', currentLocale)}</h3>
					<p class="mt-3 text-slate-700 leading-relaxed">{tsdg('sdg.why.2.desc', currentLocale)}</p>
				</article>
				<article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
					<h3 class="text-lg font-semibold">{tsdg('sdg.why.3.title', currentLocale)}</h3>
					<p class="mt-3 text-slate-700 leading-relaxed">{tsdg('sdg.why.3.desc', currentLocale)}</p>
				</article>
			</div>
		</div>
	</section>

	<section class="bg-white text-slate-900">
		<div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
			<h2 class="text-2xl md:text-4xl font-serif">{tsdg('sdg.targets.title', currentLocale)}</h2>
			<p class="mt-4 text-slate-600 leading-relaxed max-w-3xl">
				{tsdg('sdg.targets.instructions', currentLocale)}
			</p>
			<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 items-stretch">
				{detailedTargets.map((target) => (
					<article class="group h-full [perspective:1200px]" tabindex="0" aria-label={`${target.id} ${target.title}`}>
						<div class="relative h-full min-h-[640px] w-full rounded-2xl transition-transform duration-700 [transform-style:preserve-3d] group-hover:[transform:rotateY(180deg)] group-focus:[transform:rotateY(180deg)]">
						<div class="absolute inset-0 rounded-2xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-5 shadow-md [backface-visibility:hidden] flex flex-col">
							<p class="text-xs font-semibold tracking-[0.2em] text-sky-700">TARGET {target.id}</p>
							<Image src={target.src} alt={`${target.id} ${tsdg(target.title, currentLocale)}`} class="mt-3 w-full aspect-[1524/2223] object-contain object-top rounded-xl bg-slate-100" loading="lazy" />
							<h3 class="mt-4 text-xl font-semibold leading-snug min-h-[56px]">{tsdg(target.title, currentLocale)}</h3>
							</div>
							<div class="absolute inset-0 rounded-2xl border border-cyan-100 bg-slate-900 p-6 text-slate-100 [backface-visibility:hidden] [transform:rotateY(180deg)] shadow-xl overflow-y-auto">
								<p class="text-xs font-semibold tracking-[0.2em] text-cyan-300">TARGET {target.id}</p>
								<h3 class="mt-3 text-xl font-semibold leading-snug">{tsdg(target.title, currentLocale)}</h3>
								<p class="mt-4 text-lg leading-relaxed text-slate-200/90">{tsdg(target.desc, currentLocale)}</p>
							</div>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section id="how-to-participate" class="bg-slate-900 text-slate-100">
		<div class="max-w-6xl mx-auto px-6 py-16 md:py-20">
			<h2 class="text-2xl md:text-4xl font-serif">{tsdg('sdg.participate.title', currentLocale)}</h2>
			<ul class="mt-8 grid gap-4 md:grid-cols-2 text-slate-200/90 leading-relaxed">
				<li class="rounded-xl border border-white/10 bg-white/5 p-5">{tsdg('sdg.participate.1', currentLocale)}</li>
				<li class="rounded-xl border border-white/10 bg-white/5 p-5">{tsdg('sdg.participate.2', currentLocale)}</li>
				<li class="rounded-xl border border-white/10 bg-white/5 p-5">{tsdg('sdg.participate.3', currentLocale)}</li>
				<li class="rounded-xl border border-white/10 bg-white/5 p-5">{tsdg('sdg.participate.4', currentLocale)}</li>
			</ul>
			<div class="mt-8">
				<a href={localeUrl('/news')} class="inline-flex items-center gap-2 rounded-full bg-cyan-400 px-5 py-3 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-300">
					{tsdg('sdg.cta.news', currentLocale)}
				</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	#sdgHero {
		isolation: isolate;
		min-height: calc(100vh - var(--nav-height, 64px));
		min-height: calc(100dvh - var(--nav-height, 64px));
	}

	.sdg-hero-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		pointer-events: none;
	}

	.sdg-hero-vignette {
		z-index: 1;
		pointer-events: none;
		background:
			radial-gradient(circle at 50% 35%, rgba(125, 211, 252, 0.08), rgba(125, 211, 252, 0) 52%),
			linear-gradient(180deg, rgba(2, 6, 23, 0.14) 0%, rgba(2, 6, 23, 0.36) 100%);
	}
</style>
<script src="../../scripts/sdg-hero-canvas.js"></script>
