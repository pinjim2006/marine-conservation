---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { t } from '../../../i18n/ui';

const currentLocale = Astro.currentLocale ?? 'zh-tw';
const localeUrl = (path: string) => `/${currentLocale}${path}`;
const googleTranslateTarget = currentLocale === 'zh-tw' ? '' : currentLocale;
const shouldUseGoogleTranslate = googleTranslateTarget !== '';

// 1. 產生所有路徑
export async function getStaticPaths() {
  const newsEntries = await getCollection('news', ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });
  const locales = ['zh-tw', 'en', 'ja'];

  return newsEntries.flatMap((entry: CollectionEntry<'news'>) =>
    locales.map((lang) => ({ params: { lang, slug: entry.id }, props: { entry } }))
  );
}
// 2. 取得該篇新聞資料
const { entry } = Astro.props as { entry: CollectionEntry<'news'> };
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | 漁夫視角的海洋保育`}>
  <article class="bg-slate-50">
    <header translate="no" class="notranslate bg-slate-950 text-slate-100">
      <div class="max-w-4xl mx-auto px-6 py-16 md:py-20">
        <a href={localeUrl('/news')} class="inline-flex items-center gap-2 text-sm font-semibold text-cyan-300 transition-colors hover:text-cyan-200">
          <span aria-hidden="true">←</span>
          {t('news.back', currentLocale)}
        </a>
        <p class="mt-6 text-cyan-300/80 tracking-[0.22em] uppercase text-xs md:text-sm">News Detail</p>
        <h1 class="mt-4 text-4xl md:text-6xl font-serif leading-tight text-white">{entry.data.title}</h1>
        <p class="mt-5 text-slate-300/85">{entry.data.date.toLocaleDateString('zh-TW')} · 作者 {entry.data.author}</p>
      </div>
    </header>

    <div class="max-w-4xl mx-auto px-6 py-12 md:py-16">
      <div class="content prose prose-slate prose-lg max-w-none mt-10 prose-headings:font-serif prose-a:text-sky-700 hover:prose-a:text-sky-600">
        <Content />
      </div>
    </div>

    {shouldUseGoogleTranslate && (
      <div id="google_translate_element" class="google-translate-host" aria-hidden="true"></div>
    )}
  </article>
</Layout>

<script is:inline define:vars={{ googleTranslateTarget, shouldUseGoogleTranslate }}>
  if (shouldUseGoogleTranslate) {
    const translateHostId = 'google_translate_element';
    const translateScriptId = 'google-translate-element-script';
    const sourceLanguage = 'zh-TW';

    const setTranslateCookie = () => {
      document.cookie = `googtrans=/${sourceLanguage}/${googleTranslateTarget}; path=/`;
    };

    const clearTranslateCookie = () => {
      document.cookie = 'googtrans=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
    };

    const applyTranslation = () => {
      const combo = document.querySelector(`#${translateHostId} .goog-te-combo`);
      if (!(combo instanceof HTMLSelectElement)) {
        return false;
      }

      combo.value = googleTranslateTarget;
      combo.dispatchEvent(new Event('change'));
      return true;
    };

    const waitForTranslationControl = () => {
      if (applyTranslation()) {
        return;
      }

      window.setTimeout(waitForTranslationControl, 150);
    };

    window.googleTranslateElementInit = () => {
      const host = document.getElementById(translateHostId);
      if (!host || !window.google?.translate?.TranslateElement) {
        return;
      }

      new window.google.translate.TranslateElement(
        {
          pageLanguage: sourceLanguage,
          includedLanguages: 'en,ja,zh-TW',
          autoDisplay: false,
        },
        translateHostId,
      );

      waitForTranslationControl();
    };

    setTranslateCookie();

    if (!document.getElementById(translateScriptId)) {
      const script = document.createElement('script');
      script.id = translateScriptId;
      script.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
      script.async = true;
      document.head.appendChild(script);
    } else if (window.google?.translate?.TranslateElement) {
      window.googleTranslateElementInit();
    }

    window.addEventListener('beforeunload', clearTranslateCookie, { once: true });
  }
</script>

<style is:global>
  .google-translate-host {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
    pointer-events: none;
  }

  .goog-te-banner-frame.skiptranslate,
  iframe.goog-te-banner-frame,
  #goog-gt-tt,
  .goog-te-balloon-frame,
  .goog-tooltip,
  .goog-tooltip:hover {
    display: none !important;
  }

  body {
    top: 0 !important;
  }
</style>