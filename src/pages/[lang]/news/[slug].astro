---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const currentLocale = Astro.currentLocale ?? 'zh-tw';
const localeUrl = (path: string) => `/${currentLocale}${path}`;

// 1. 產生所有路徑
export async function getStaticPaths() {
  const newsEntries = await getCollection('news', ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });
  const locales = ['zh-tw', 'en'];

  return newsEntries.flatMap((entry: CollectionEntry<'news'>) =>
    locales.map((lang) => ({ params: { lang, slug: entry.id }, props: { entry } }))
  );
}
// 2. 取得該篇新聞資料
const { entry } = Astro.props as { entry: CollectionEntry<'news'> };
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | 漁夫視角的海洋保育`}>
  <article class="bg-slate-50">
    <header class="bg-slate-950 text-slate-100">
      <div class="max-w-4xl mx-auto px-6 py-16 md:py-20">
        <a href={localeUrl('/news')} class="inline-flex items-center gap-2 text-sm font-semibold text-cyan-300 transition-colors hover:text-cyan-200">
          <span aria-hidden="true">←</span>
          回到新聞列表
        </a>
        <p class="mt-6 text-cyan-300/80 tracking-[0.22em] uppercase text-xs md:text-sm">News Detail</p>
        <h1 class="mt-4 text-4xl md:text-6xl font-serif leading-tight text-white">{entry.data.title}</h1>
        <p class="mt-5 text-slate-300/85">{entry.data.date.toLocaleDateString('zh-TW')} · 作者 {entry.data.author}</p>
      </div>
    </header>

    <div class="max-w-4xl mx-auto px-6 py-12 md:py-16">
      <div class="content prose prose-slate prose-lg max-w-none mt-10 prose-headings:font-serif prose-a:text-sky-700 hover:prose-a:text-sky-600">
        <Content />
      </div>
    </div>
  </article>
</Layout>