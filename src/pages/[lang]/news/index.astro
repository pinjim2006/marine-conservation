---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { t } from '../../../i18n/ui';

const currentLocale = Astro.currentLocale ?? 'zh-tw';
const localeUrl = (path: string) => `/${currentLocale}${path}`;
const googleTranslateTarget = currentLocale === 'zh-tw' ? '' : currentLocale;
const shouldUseGoogleTranslate = googleTranslateTarget !== '';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'zh-tw' } },
  ];
}

const allNews = await getCollection('news', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});
const sortedNews = allNews.sort((a: CollectionEntry<'news'>, b: CollectionEntry<'news'>) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title='相關新聞 | 漁夫視角的海洋保育'>
  <section translate="no" class="bg-slate-950 text-slate-100">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-24">
      <p class="text-cyan-300/80 tracking-[0.22em] uppercase text-xs md:text-sm">News Archive</p>
      <h1 class="mt-4 text-4xl md:text-6xl font-serif leading-tight">相關新聞</h1>
      <p class="mt-6 max-w-3xl text-slate-300/85 leading-relaxed md:text-lg">
        收集與海洋保育、漁業、氣候與政策相關的最新報導，方便快速閱讀與延伸追蹤。
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {sortedNews.map((item: CollectionEntry<'news'>) => (
          <article class="group overflow-hidden rounded-3xl border border-white/10 bg-white/5 backdrop-blur-sm shadow-[0_18px_60px_rgba(2,6,23,0.35)] transition-transform duration-300 hover:-translate-y-1">
            <div class="relative aspect-[16/10] overflow-hidden bg-slate-800">
              <img src={item.data.cover.src} alt={item.data.title} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/15 to-transparent"></div>
            </div>
            <div class="p-6">
              <p class="text-xs tracking-[0.22em] uppercase text-cyan-300/80">News</p>
              <h2 translate="yes" class="mt-3 text-xl font-semibold leading-snug text-white">{item.data.title}</h2>
              <p class="mt-3 text-sm text-slate-300/80">{item.data.date.toLocaleDateString('zh-TW')}</p>
              <p translate="yes" class="mt-4 line-clamp-4 text-slate-300/90 leading-relaxed">{item.data.summary}</p>
              <a href={localeUrl(`/news/${item.id}`)} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-cyan-300 transition-colors hover:text-cyan-200">
                {t('news.readMore', currentLocale)}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>

    {shouldUseGoogleTranslate && (
      <div id="google_translate_element" class="google-translate-host" aria-hidden="true"></div>
    )}
  </section>
</Layout>

<script is:inline define:vars={{ googleTranslateTarget, shouldUseGoogleTranslate }}>
  if (shouldUseGoogleTranslate) {
    const translateHostId = 'google_translate_element';
    const translateScriptId = 'google-translate-element-script';
    const sourceLanguage = 'zh-TW';

    const setTranslateCookie = () => {
      document.cookie = `googtrans=/${sourceLanguage}/${googleTranslateTarget}; path=/`;
    };

    const clearTranslateCookie = () => {
      document.cookie = 'googtrans=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
    };

    const applyTranslation = () => {
      const combo = document.querySelector(`#${translateHostId} .goog-te-combo`);
      if (!(combo instanceof HTMLSelectElement)) {
        return false;
      }

      combo.value = googleTranslateTarget;
      combo.dispatchEvent(new Event('change'));
      return true;
    };

    const waitForTranslationControl = () => {
      if (applyTranslation()) {
        return;
      }

      window.setTimeout(waitForTranslationControl, 150);
    };

    window.googleTranslateElementInit = () => {
      const host = document.getElementById(translateHostId);
      if (!host || !window.google?.translate?.TranslateElement) {
        return;
      }

      new window.google.translate.TranslateElement(
        {
          pageLanguage: sourceLanguage,
          includedLanguages: 'en,ja,zh-TW',
          autoDisplay: false,
        },
        translateHostId,
      );

      waitForTranslationControl();
    };

    setTranslateCookie();

    if (!document.getElementById(translateScriptId)) {
      const script = document.createElement('script');
      script.id = translateScriptId;
      script.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
      script.async = true;
      document.head.appendChild(script);
    } else if (window.google?.translate?.TranslateElement) {
      window.googleTranslateElementInit();
    }

    window.addEventListener('beforeunload', clearTranslateCookie, { once: true });
  }
</script>

<style is:global>
  #google_translate_element,
  .google-translate-host {
    display: none !important;
    visibility: hidden !important;
  }

  .goog-te-banner-frame,
  iframe.skiptranslate,
  .skiptranslate iframe,
  [id*=":container"],
  [id*=".container"],
  .VIpgJd-ZVi9od-ORHb-OEVmcd {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  #goog-gt-tt,
  .goog-te-balloon-frame,
  .goog-tooltip {
    display: none !important;
    visibility: hidden !important;
  }

  body {
    top: 0 !important;
    position: static !important;
  }
</style>