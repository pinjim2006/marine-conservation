---
// src/pages/index.astro
---
<script is:inline>
  // 取得瀏覽器語言 (例如 "zh-TW" 或 "en-US")
  const navLang = navigator.language.toLowerCase();
  
  if (navLang.includes('en')) {
    window.location.pathname = '/en/';
  } else {
    window.location.pathname = '/zh-tw/';
  }
</script>

<!-- 作為保險，如果 JS 被禁用，依然導向預設語系 -->
<noscript>
  <meta http-equiv="refresh" content="0;url=/zh-tw/" />
</noscript>