---
// src/layouts/Layout.astro
import '../styles/global.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../i18n/ui';
import BubbleCursor from '../components/BubbleCursor.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
const currentLocale = Astro.currentLocale ?? 'zh-tw';
const localeUrl = (path: string) => getRelativeLocaleUrl(currentLocale, path);
const htmlLang = currentLocale === 'zh-tw' ? 'zh-TW' : currentLocale;
---

<!doctype html>
<html lang={htmlLang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="A Fisherman's Perspective on Marine Conservation" />
		<meta name="viewport" content="width=device-width" />
			<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-slate-50 text-slate-900 selection:bg-blue-200 selection:text-blue-900">
		<nav translate="no" class="notranslate fixed top-0 left-0 w-full z-50 bg-slate-900/80 backdrop-blur-md text-white border-b border-white/10">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between gap-4">
					<a href={localeUrl('/')}>
					<div class="flex items-center space-x-2">
						<span class="text-2xl italic font-serif">Deep Blue</span>
						<div class="h-6 w-0.5 bg-blue-500 mx-2"></div>
						<span class="text-sm tracking-widest uppercase opacity-70">SDG 14</span>
					</div>
				</a>

				<div class="hidden md:flex space-x-8 text-sm font-medium tracking-wide">
						<a href={localeUrl('/')} class="hover:text-blue-400 transition-colors">{t('nav.home', currentLocale)}</a>
						<a href={localeUrl('/story')} class="hover:text-blue-400 transition-colors">{t('nav.story', currentLocale)}</a>
						<a href={localeUrl('/game')} class="hover:text-blue-400 transition-colors">{t('nav.game', currentLocale)}</a>
						<a href={localeUrl('/news')} class="hover:text-blue-400 transition-colors">{t('nav.news', currentLocale)}</a>
						<a href={localeUrl('/sdg')} class="hover:text-blue-400 transition-colors">{t('nav.sdg', currentLocale)}</a>
				</div>

				<div class="hidden md:flex items-center">
				<a data-join-action href={`${localeUrl('/game')}#action-external`} class="bg-blue-600 hover:bg-blue-500 text-white px-5 py-2 rounded-full text-xs font-bold transition-all shadow-lg shadow-blue-500/20">
					{t('cta.join', currentLocale)}
					</a>
					<div class="relative ml-4" data-lang-group>
						<button data-lang-toggle class="inline-flex items-center justify-center rounded-md hover:text-blue-400 p-2 hover:scale-105 transition-transform" aria-expanded="false" aria-label="Open language menu">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 globe-icon" data-globe>
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
							</svg>

						</button>
							<div data-lang-menu class="desktop-lang-panel hidden absolute right-0 top-full mt-2 w-40 overflow-hidden rounded-md bg-slate-800 text-white shadow-lg ring-1 ring-black/20">
							<button data-lang-option="zh-tw" class="w-full text-left px-3 py-2 hover:bg-slate-700">繁體中文</button>
							<button data-lang-option="en" class="w-full text-left px-3 py-2 hover:bg-slate-700">English</button>
							<button data-lang-option="ja" class="w-full text-left px-3 py-2 hover:bg-slate-700">日本語</button>
						</div>
					</div>
				</div>

				<!--- Mobile Controls --->
				<div class="relative block w-full md:hidden" data-lang-group>
					<div class="flex w-full items-center justify-end gap-1">
						<button data-lang-toggle class="inline-flex shrink-0 items-center justify-center rounded-md p-1.5 transition-transform hover:scale-105 hover:text-blue-400" aria-expanded="false" aria-label="Open language menu (mobile)">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 globe-icon" data-globe>
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
							</svg>
						</button>
						<details class="mobile-menu static block w-fit" data-mobile-menu>
							<summary class="ml-auto flex w-fit list-none cursor-pointer items-center justify-center p-2 text-white transition-colors hover:text-blue-400">
								<span class="sr-only">開啟導覽選單</span>
								<span aria-hidden="true" class="flex flex-col gap-1.5">
									<span class="block h-0.5 w-6 bg-current"></span>
									<span class="block h-0.5 w-6 bg-current"></span>
									<span class="block h-0.5 w-6 bg-current"></span>
								</span>	
							</summary>
							<div class="mobile-menu-panel fixed left-0 right-0 top-20 z-50 mt-0 w-screen border-t border-white/10 bg-slate-950/95 shadow-2xl backdrop-blur-xl">
								<div class="flex flex-col text-sm font-medium">
									<a href={localeUrl('/')} class="border-b border-white/10 px-4 py-4 text-center text-white transition-colors hover:bg-white/10">{t('nav.home', currentLocale)}</a>
									<a href={localeUrl('/story')} class="border-b border-white/10 px-4 py-4 text-center text-white transition-colors hover:bg-white/10">{t('nav.story', currentLocale)}</a>
									<a href={localeUrl('/game')} class="border-b border-white/10 px-4 py-4 text-center text-white transition-colors hover:bg-white/10">{t('nav.game', currentLocale)}</a>
									<a href={localeUrl('/news')} class="border-b border-white/10 px-4 py-4 text-center text-white transition-colors hover:bg-white/10">{t('nav.news', currentLocale)}</a>
									<a href={localeUrl('/sdg')} class="px-4 py-4 text-center text-white transition-colors hover:bg-white/10">{t('nav.sdg', currentLocale)}</a>
									<a href={`${localeUrl('/game')}#action-external`} class="block px-4 py-4 text-center text-sm font-bold text-white transition-colors hover:bg-blue-600/30">{t('cta.join', currentLocale)}</a>
								</div>
							</div>
						</details>
					</div>
					<div data-lang-menu class="mobile-lang-panel hidden fixed left-0 right-0 top-20 z-50 mt-0 w-screen overflow-hidden rounded-md bg-slate-800 text-white shadow-lg ring-1 ring-black/20">
						<button data-lang-option="zh-tw" class="block w-full px-4 py-3 text-center hover:bg-slate-700">繁體中文</button>
						<button data-lang-option="en" class="block w-full px-4 py-3 text-center hover:bg-slate-700">English</button>
						<button data-lang-option="ja" class="block w-full px-4 py-3 text-center hover:bg-slate-700">日本語</button>
					</div>
				</div>
			</div>
		</nav>

		<style>
			.mobile-menu > .mobile-menu-panel {
				display: block;
				max-height: 0;
				opacity: 0;
				overflow: hidden;
				pointer-events: none;
				transition: max-height 320ms ease, opacity 220ms ease;
			}

			.mobile-menu > .mobile-menu-panel.is-expanded {
				max-height: calc(100vh - 5rem);
				opacity: 1;
				pointer-events: auto;
			}

			.mobile-menu > summary::-webkit-details-marker {
				display: none;
			}

			[data-lang-menu].desktop-lang-panel {
				display: block;
				max-height: 0;
				opacity: 0;
				overflow: hidden;
				pointer-events: none;
				transition: max-height 320ms ease, opacity 220ms ease;
			}

			[data-lang-menu].desktop-lang-panel.is-expanded {
				max-height: 9rem;
				opacity: 1;
				pointer-events: auto;
			}

			/* Mobile: make language menu behave like the mobile hamburger panel */
			[data-lang-menu].mobile-lang-panel {
				max-height: 0;
				opacity: 0;
				overflow: hidden;
				pointer-events: none;
				transition: max-height 320ms ease, opacity 220ms ease;
				width: 100vw;
				left: 0;
				right: 0;
			}

			[data-lang-menu].mobile-lang-panel.is-expanded {
				max-height: 12rem;
				opacity: 1;
				pointer-events: auto;
			}

			@keyframes spinClockwise {
				from {
					transform: rotate(0deg);
				}
				to {
					transform: rotate(360deg);
				}
			}

			@keyframes spinCounterClockwise {
				from {
					transform: rotate(0deg);
				}
				to {
					transform: rotate(-360deg);
				}
			}

			.globe-icon.spin-cw {
				animation: spinClockwise 0.4s ease-in-out forwards;
			}

			.globe-icon.spin-ccw {
				animation: spinCounterClockwise 0.4s ease-in-out forwards;
			}
		</style>

		<main class="pt-20">
			<slot />
		</main>

		<footer translate="no" class="notranslate bg-slate-900 text-slate-500 py-12 text-center text-sm">
			<p>© 2026 網頁程式設計期末專案 - 漁夫視角的海洋保育</p>
			<p class="mt-2 opacity-50">Developed with Astro + Tailwind CSS + GSAP</p>
		</footer>

		<BubbleCursor />		

		<script is:inline>
			const mobileMenu = document.querySelector("[data-mobile-menu]");
			if (mobileMenu) {
				const panel = mobileMenu.querySelector(".mobile-menu-panel");
				const summary = mobileMenu.querySelector("summary");
				const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
				const transitionFallbackMs = 380;
				let closeTimerId = 0;
				let openFrameId = 0;

				const finishClosing = () => {
					if (closeTimerId) {
						window.clearTimeout(closeTimerId);
						closeTimerId = 0;
					}
					if (openFrameId) {
						window.cancelAnimationFrame(openFrameId);
						openFrameId = 0;
					}
					mobileMenu.removeAttribute("data-closing");
					mobileMenu.removeAttribute("open");
					panel?.classList.remove("is-expanded");
					if (panel) {
						panel.style.maxHeight = "0px";
					}
				};

				const openMenu = () => {
					if (!panel || mobileMenu.hasAttribute("open")) {
						return;
					}
					mobileMenu.setAttribute("open", "");
					panel.classList.remove("is-expanded");
					panel.style.maxHeight = "0px";
					openFrameId = window.requestAnimationFrame(() => {
						openFrameId = 0;
						panel.classList.add("is-expanded");
						panel.style.maxHeight = "calc(100vh - 5rem)";
					});
				};

				const closeMenu = () => {
					if (mobileMenu.hasAttribute("data-closing")) {
						return;
					}
					if (prefersReducedMotion.matches) {
						finishClosing();
						return;
					}
					mobileMenu.setAttribute("data-closing", "true");
					if (panel) {
						panel.classList.remove("is-expanded");
						panel.style.maxHeight = "0px";
						panel.addEventListener("transitionend", finishClosing, { once: true });
					}
					closeTimerId = window.setTimeout(finishClosing, transitionFallbackMs);
				};

				summary?.addEventListener("click", (event) => {
					event.preventDefault();
					if (mobileMenu.hasAttribute("open")) {
						closeMenu();
					} else {
						openMenu();
					}
				});
			}
		</script>

		<script is:inline>
			(function(){
				const locales = ['zh-tw','en','ja'];
				const openTransitionMs = 320;
				function buildPathForLocale(locale){
					const path = window.location.pathname;
					const parts = path.split('/').filter(Boolean);
					if(parts.length && locales.includes(parts[0])){
						parts[0] = locale;
					} else {
						parts.unshift(locale);
					}
					return '/' + parts.join('/') + window.location.search + window.location.hash;
				}

				// handle legacy <select data-lang-select>
				document.querySelectorAll('select[data-lang-select]').forEach(el => {
					const cur = el.getAttribute('data-current-locale');
					if(cur) el.value = cur;
					el.addEventListener('change', (e)=>{
						const v = e.target.value;
						window.location.href = buildPathForLocale(v);
					});
				});

				// handle globe button + menu dropdowns
					document.querySelectorAll('[data-lang-toggle]').forEach(btn => {
					const wrapper = btn.closest('[data-lang-group]');
					if(!wrapper) return;
					const menu = wrapper.querySelector('[data-lang-menu]');
					if(!menu) return;
					const globeIcon = btn.querySelector('[data-globe]');
					const isMobileMenu = wrapper.classList.contains('block');
					let openFrameId = 0;
					let hideTimerId = 0;

					function spinClockwise(){
						if(globeIcon){
							globeIcon.classList.remove('spin-ccw');
							globeIcon.classList.add('spin-cw');
						}
					}

					function spinCounterClockwise(){
						if(globeIcon){
							globeIcon.classList.remove('spin-cw');
							globeIcon.classList.add('spin-ccw');
						}
					}

					function showMenu(){
						btn.setAttribute('aria-expanded','true');
						if (hideTimerId) {
							window.clearTimeout(hideTimerId);
							hideTimerId = 0;
						}
						menu.classList.remove('hidden');
						menu.classList.remove('is-expanded');
						menu.style.maxHeight = '0px';
						menu.style.opacity = '0';
						if (openFrameId) {
							window.cancelAnimationFrame(openFrameId);
						}
						openFrameId = window.requestAnimationFrame(() => {
							openFrameId = 0;
							menu.classList.add('is-expanded');
							menu.style.maxHeight = isMobileMenu ? '12rem' : '9rem';
							menu.style.opacity = '1';
						});
						spinClockwise();
						document.addEventListener('click', onDocClick);
					}

					function hideMenu(){
						btn.setAttribute('aria-expanded','false');
						if (openFrameId) {
							window.cancelAnimationFrame(openFrameId);
							openFrameId = 0;
						}
						if (hideTimerId) {
							window.clearTimeout(hideTimerId);
							hideTimerId = 0;
						}
						menu.classList.remove('is-expanded');
						menu.style.maxHeight = '0px';
						menu.style.opacity = '0';
						spinCounterClockwise();
						hideTimerId = window.setTimeout(()=>{
							hideTimerId = 0;
							menu.classList.add('hidden');
						}, openTransitionMs + 60);
						document.removeEventListener('click', onDocClick);
					}

					function onDocClick(e){
						if(!wrapper.contains(e.target)) hideMenu();
					}

					// click to toggle (no hover auto-open)
					btn.addEventListener('click', (e)=>{
						e.stopPropagation();
						const expanded = btn.getAttribute('aria-expanded') === 'true';
						if(expanded) hideMenu(); else showMenu();
					});

					menu.querySelectorAll('[data-lang-option]').forEach(opt => {
						opt.addEventListener('click', (e)=>{
							const v = opt.getAttribute('data-lang-option');
							if(v) window.location.href = buildPathForLocale(v);
						});
					});
				});

			})();
		</script>
	</body>
</html>