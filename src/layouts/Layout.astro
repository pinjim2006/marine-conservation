---
// src/layouts/Layout.astro
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-TW" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="A Fisherman's Perspective on Marine Conservation" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-slate-50 text-slate-900 selection:bg-blue-200 selection:text-blue-900">
		<nav class="fixed top-0 left-0 w-full z-50 bg-slate-900/80 backdrop-blur-md text-white border-b border-white/10">
			<div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
				<div class="flex items-center space-x-2">
					<span class="text-2xl italic font-serif">Deep Blue</span>
					<div class="h-6 w-[2px] bg-blue-500 mx-2"></div>
					<span class="text-sm tracking-widest uppercase opacity-70">SDG 14</span>
				</div>

				<div class="hidden md:flex space-x-8 text-sm font-medium tracking-wide">
					<a href="/" class="hover:text-blue-400 transition-colors">首頁</a>
					<a href="/story" class="hover:text-blue-400 transition-colors">漁夫的故事</a>
					<a href="/game" class="hover:text-blue-400 transition-colors">撒網體驗</a>
					<a href="/news" class="hover:text-blue-400 transition-colors">相關新聞</a>
					<a href="/sdg" class="hover:text-blue-400 transition-colors">關於 SDG 14</a>
				</div>

				<div class="flex items-center">
					<button class="bg-blue-600 hover:bg-blue-500 text-white px-5 py-2 rounded-full text-xs font-bold transition-all shadow-lg shadow-blue-500/20">
						加入行動
					</button>
				</div>
			</div>
		</nav>

		<main class="pt-20">
			<slot />
		</main>

		<footer class="bg-slate-900 text-slate-500 py-12 text-center text-sm">
			<p>© 2026 網頁程式設計期末專案 - 漁夫視角的海洋保育</p>
			<p class="mt-2 opacity-50">Developed with Astro + Tailwind CSS + GSAP</p>
		</footer>
	</body>
</html>