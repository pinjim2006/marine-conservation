---
// src/components/BubbleCursor.astro
---

<!-- 準備一個滿版畫布，不影響下方元素的點擊 -->
<canvas id="bubble-canvas"></canvas>
<!-- 自訂柔邊藍點游標 -->
<div id="custom-cursor" aria-hidden="true"></div>

<style>
  #bubble-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none; /* 讓滑鼠點擊穿透畫布，不影響網頁原本的按鈕 */
    z-index: 9999;        /* 確保在最上層 */
  }
  /* 全域：隱藏系統游標（在需要時由 JS 加上 body.hide-native-cursor）
     包含所有子元素以覆蓋預設的 a:hover 對手形的影響 */
  body.hide-native-cursor,
  body.hide-native-cursor * {
    cursor: none !important;
  }
  /* Removed: keep native cursor hidden even on interactive elements; use custom cursor instead */
  /* 自訂游標樣式：柔邊藍點 */
  #custom-cursor {
    position: fixed;
    left: 0;
    top: 0;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(60,140,255,0.95);
    box-shadow: 0 0 22px 10px rgba(60,140,255,0.18), 0 2px 6px rgba(0,0,0,0.08) inset;
    transform: translate(-50%, -50%) scale(1);
    pointer-events: none;
    z-index: 10000;
    transition: transform 120ms linear, opacity 160ms linear;
    opacity: 1;
  }
  /* 當隱藏原生游標被關閉時（互動元件），同時隱藏自訂游標 */
  /* 當游標處於互動元素上時，改變自訂游標外觀以示區別（仍為自訂點） */
  body.cursor-interactive #custom-cursor {
    transform: translate(-50%, -50%) scale(1.6);
    width: 22px;
    height: 22px;
    background: rgba(40,120,255,0.98);
    box-shadow: 0 0 26px 12px rgba(60,140,255,0.22), 0 2px 6px rgba(0,0,0,0.08) inset;
    border: 2px solid rgba(255,255,255,0.45);
  }
</style>

<script>
  class BubbleEffect {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    particles: any[];

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.ctx = canvas.getContext('2d')!;
      this.particles = [];
      this.init();
    }

    init() {
      this.resizeCanvas();
      window.addEventListener('resize', () => this.resizeCanvas());
      window.addEventListener('mousemove', (e) => this.addParticle(e.clientX, e.clientY));
      
      // 開始動畫迴圈
      this.animate();
    }

    resizeCanvas() {
      this.canvas.width = window.innerWidth;
      this.canvas.height = window.innerHeight;
    }

    addParticle(x: number, y: number) {
      // 限制同時存在的粒子數量以維持效能（降低密度）
      if (this.particles.length >= 50) return;
      // 降低生成頻率：只有部分移動事件會產生氣泡
      if (Math.random() > 0.45) return;

      this.particles.push({
        x: x,
        y: y,
        size: Math.random() * 8 + 4, // 氣泡大小：4px ~ 12px
        // 減小左右飄散速度，讓氣泡移動更平緩
        speedX: Math.random() * 0.6 - 0.3,
        // 放慢上升速度（數值較小，向上飄得更慢）
        speedY: Math.random() * -1 - 0.4,
        opacity: 1,
        // 使用半透明的淡藍色/白色氣泡，很有海洋感
        color: `hsla(${200 + Math.random() * 20}, 80%, 80%, `
      });
    }

    animate() {
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

      for (let i = this.particles.length - 1; i >= 0; i--) {
        const p = this.particles[i];
        p.x += p.speedX;
        p.y += p.speedY;
        p.opacity -= 0.008; // 逐漸淡出（減慢淡出，使氣泡停留久一點）

        if (p.opacity <= 0) {
          this.particles.splice(i, 1);
          continue;
        }

        // 繪製氣泡外圈
        this.ctx.beginPath();
        this.ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        this.ctx.strokeStyle = p.color + p.opacity + ')';
        this.ctx.lineWidth = 1.5;
        this.ctx.stroke();

        // 繪製氣泡反光小點
        this.ctx.beginPath();
        this.ctx.arc(p.x - p.size * 0.3, p.y - p.size * 0.3, p.size * 0.1, 0, Math.PI * 2);
        this.ctx.fillStyle = `rgba(255, 255, 255, ${p.opacity})`;
        this.ctx.fill();
      }

      requestAnimationFrame(() => this.animate());
    }
  }

  function initEffect() {
    const canvas = document.getElementById('bubble-canvas') as HTMLCanvasElement;
    if (canvas) {
      new BubbleEffect(canvas);
    }
  }

  // 自訂游標跟隨與平滑動畫
  function initCustomCursor() {
    const el = document.getElementById('custom-cursor');
    if (!el) return;
    const cursor = el as HTMLDivElement;

    let targetX = window.innerWidth / 2;
    let targetY = window.innerHeight / 2;
    let x = targetX;
    let y = targetY;

    function onMove(e: MouseEvent) {
      targetX = e.clientX;
      targetY = e.clientY;
      cursor.style.transform = 'translate(-50%, -50%) scale(1)';
    }

    // 平滑動畫 loop
    function frame() {
      x += (targetX - x) * 0.18;
      y += (targetY - y) * 0.18;
      cursor.style.left = x + 'px';
      cursor.style.top = y + 'px';
      requestAnimationFrame(frame);
    }

    window.addEventListener('mousemove', onMove);
    requestAnimationFrame(frame);
  }

  // 隱藏原生游標的啟用邏輯（idempotent）
  function enableHideNativeCursor() {
    // 防止重複綁定
    if ((window as any).__bubbleCursorHideEnabled) return;
    (window as any).__bubbleCursorHideEnabled = true;

    const body = document.body;
    if (!body) return;
    body.classList.add('hide-native-cursor');

    // 確保覆蓋任何先行的 cursor 規則：動態插入最後的全域樣式
    if (!document.getElementById('bubble-cursor-global-style')) {
      const s = document.createElement('style');
      s.id = 'bubble-cursor-global-style';
      s.textContent = '* { cursor: none !important; }';
      document.head.appendChild(s);
    }

    const interactiveSelector = 'input,textarea,select,button,a,[role="button"]';

    function onFocusIn(e: FocusEvent) {
      const t = e.target as Element | null;
      if (t && t.matches && t.matches(interactiveSelector)) {
        body.classList.add('cursor-interactive');
      }
    }

    function onFocusOut() {
      body.classList.remove('cursor-interactive');
    }

    function onMouseOver(e: MouseEvent) {
      const t = e.target as Element | null;
      if (t && t.matches && t.matches(interactiveSelector)) {
        body.classList.add('cursor-interactive');
      } else if (!document.activeElement || !(document.activeElement as Element).matches(interactiveSelector)) {
        body.classList.remove('cursor-interactive');
      }
    }

    document.addEventListener('focusin', onFocusIn);
    document.addEventListener('focusout', onFocusOut);
    document.addEventListener('mouseover', onMouseOver);
  }

  // 初始執行
  initEffect();
  // 啟用隱藏原生游標（網頁範圍內）
  enableHideNativeCursor();

  // 支援 Astro View Transitions 頁面切換
  document.addEventListener('astro:after-swap', initEffect);
  // 初始化自訂游標
  initCustomCursor();
</script>